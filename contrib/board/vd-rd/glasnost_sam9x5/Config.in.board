config	GLASNOST_SAM9X5
	bool "glasnost_sam9x5"
	select AT91SAM9X5
	select DDRC
	select ALLOW_DATAFLASH
	select ALLOW_SDCARD
	select ALLOW_CPU_CLK_400MHZ
	select ALLOW_CRYSTAL_12_000MHZ
	select ALLOW_BOOT_FROM_DATAFLASH_CS0
#	select ALLOW_DATAFLASH_RECOVERY
	select SUPPORT_BUS_SPEED_133MHZ

	help
	    Use the GLASNOST SAM9X5 IoT board. Pin-compatible with the
	    AT91SAM9G15/G25/G35/X25/X35 family; this repo does not need to
	    distinguish between them.
